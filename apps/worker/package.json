{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-web-dist.mjs",
    "dev": "wrangler dev",
    "deploy": "pnpm --filter web build && wrangler deploy",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply kgames --local",
    "db:migrate:remote": "wrangler d1 migrations apply kgames --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote"
  },
  "dependencies": {
    "@kg/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
